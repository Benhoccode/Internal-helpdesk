generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  ADMIN

  @@map("user_role")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH

  @@map("ticket_priority")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("article_status")
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String   @map("full_name") @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true) @map("is_active")

  createdTickets     Ticket[]              @relation("TicketCreator")
  assignedTickets    Ticket[]              @relation("TicketAssignee")
  comments           TicketComment[]
  ticketStatusChanges TicketStatusHistory[]
  articles           Article[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String?

  tickets      Ticket[]
  articleLinks ArticleCategory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("categories")
}

model Ticket {
  id          Int    @id @default(autoincrement())
  title       String @db.VarChar(200)
  description String @db.Text

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  creatorId Int  @map("creator_id")
  creator   User @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assigneeId Int?  @map("assignee_id")
  assignee   User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  comments      TicketComment[]
  statusHistory TicketStatusHistory[]

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([creatorId, createdAt])
  @@index([assigneeId, createdAt])
  @@index([categoryId])
  @@index([status, priority])
  @@map("tickets")
}

model TicketComment {
  id      Int    @id @default(autoincrement())
  content String @db.Text

  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("ticket_comments")
}

model TicketStatusHistory {
  id Int @id @default(autoincrement())

  ticketId Int    @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  changedById Int  @map("changed_by_id")
  changedBy   User @relation(fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus  @map("to_status")
  note       String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ticketId, createdAt])
  @@index([changedById])
  @@map("ticket_status_history")
}

model Article {
  id      Int    @id @default(autoincrement())
  title   String @db.VarChar(250)
  slug    String @unique @db.VarChar(280)
  content String @db.Text
  status  ArticleStatus @default(DRAFT)

  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  categoryLinks ArticleCategory[]

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([authorId])
  @@index([status, publishedAt])
  @@map("articles")
}

model ArticleCategory {
  articleId Int     @map("article_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@id([articleId, categoryId])
  @@index([categoryId])
  @@map("article_categories")
}
